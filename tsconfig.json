{
    "extends": "@jubstaa/config/tsconfig/next",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "target": "ESNext",
        "jsx": "react-jsx",
        "types": ["bun"],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "prettier.config.ts",
        "eslint.config.ts",
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", "out"]
}
